def LoadPowerMeter():
    reader=power.powermeterreader()
    reader.singleopener()
    return reader

def QuickReader(reader=None,Integration_Time=0.1):
    output=reader.AveragePower(IntTime=Integration_Time)
    if output == 'no data available':
        return 0.0
    return output


def LoadCamera(webcam_index=1, releasecamera=False):
    beam=spot_opt.spot(webcam_index,releasecamera)
    return beam


def GetMetric(beam,BesMet=0,SSM=1,spot_size=50):
    metric=0
    if BesMet:  
        beam.decompose(no_roots, max_order, display=False)
        metric+=beam.metric()
    if SSM:     metric+=beam.metric(spot_size)
    return metric
    
    
def SpotSizeMetric(webcam_index=1, spot_size=30):
    beam=spot_opt.spot(webcam_index)
    metric=beam.metric(spot_size)
    return metric


def BesselMetric(webcam_index=1, no_roots=15, max_order=15):
    beam=bessel_opt.bessel(webcam_index, display=False)
    beam.decompose(no_roots, max_order, display=False)
    metric=beam.metric()
    return metric
    
