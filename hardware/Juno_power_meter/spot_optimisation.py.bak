    def metric(self):
        """
        Returns a fitness function to be maximised.
        A, B defined as in Nouman-ul-Haq et al., Nuclear Inst. and Methods in 
        Physics Researchs, A 883 (2018).
        Here we use the inverse of their metric, since we seek to maximise it rather than
        minimise it.
        """
        
        if not self.releasecamera: self.processimage()
        start = time.time()
        spot_size = self.fibreradius/self.pixelsize
        self.inner_radius_pixels = int(spot_size) # inner radius in pixels

        if spot_size > self.image.shape[0] or spot_size > self.image.shape[1]:
            raise Exception("The desired spot size is bigger than the image.")
                
        B = np.sum(self.image[:,:self.inner_radius_pixels])
        A = np.sum(self.image[:,self.inner_radius_pixels:])
        if A == 0: metr = np.inf
        else: metr = B**2/A
        end = time.time()
        print("Time taken by metric: ", end - start)
        return metr
        
    def plot(self):
        """Mainly for debugging purposes."""
        start = time.time()
        metric = self.metric()
        r1D = np.linspace(0., self.pixelsize*self.image.shape[0],
                          self.image.shape[0])
        phi1D = np.linspace(0., 2.*np.pi, self.image.shape[0])
        r0, phi0 = np.meshgrid(r1D, phi1D)
        
        fig = plt.figure(5)
        ax = fig.add_subplot(111, projection='polar')
        ax.axis('off')
        #ax.set_title("Focal spot metric = %g" % (metric), size=20)
        plt.pcolormesh(phi0, r0, self.image)
        plt.colorbar()
        # plt.plot(0., 0., marker='*', ms=30, markerfacecolor='w', 
