class image_processing:

    def __init__(self, webcam_index=0, fibreradius= 1., pixelsize=1., 
                 width=320, height=240,exposure=-5, gain=200, autodisconnect=True):
        """Loads image."""
        
        # To load an existing file (e.g. for testing purposes), use:
        # source = imread(webcam_index)
        # self.image = source
        
        # To acquire an image from an available webcam, use:
        self.cam=VideoCapture(webcam_index)
        cam = self.cam
        cam.set(3, width)
        cam.set(4, height)
        cam.set(13, gain)
        cam.set(15, exposure)
        
        self.read()
       
        if autodisconnect: self.disconnect()


    def read(self):
        bin, source = self.cam.read()
        if source is None:
            raise Exception("The image was not loaded. Check camera connection.")
        else:
            img = source.astype(np.float32) # Ensuring correct type
            self.image = np.flip(img, 0) # Corrects y being upside down
        self.pixelsize = pixelsize
        
    def disconnect(self):
        self.cam.release()
  
    def sharecamera(self):
        return self.cam

              
    def image2array(self, image):
        """
        Converts an image into an array containing the brightness of each
        pixel.
        """
        array = np.zeros((image.shape[0], image.shape[1]))
        
        for i in range(image.shape[0]):
            for j in range(image.shape[1]):
                for n in range(3):
                    array[i][j] += image[i][j][n]/3
        return array
        
    def makesquare(self, input):
        """Pads array with zeros until it is square."""
        diff = int(input.shape[0] - input.shape[1])
        if diff < 0:
            final = np.vstack(
                    (input, np.zeros((abs(diff), input.shape[1], 
                                      input.shape[2]))))
        if diff > 0:
            final = np.hstack(
                    (input, np.zeros((input.shape[0], diff, 
                                      input.shape[2]))))
        return final
    
    def find_centre(self, input):
        """Finds the centre of mass of the image."""
        x_mean = np.average(np.array([i for i in range(input.shape[1])]), 
                            weights = np.array([np.sum(input[:,j])+0.01
                                                for j in range(input.shape[1])]))
        y_mean = np.average(np.array([i for i in range(input.shape[0])]), 
                            weights = np.array([np.sum(input[j])+0.01 
                                                for j in range(input.shape[0])]))
        return int(round(x_mean)), int(round(y_mean))
        
    def peak_selector(self, input_array):
        """Identifies one of the peaks and replaces the other one with zeros."""
        start = time.time()
        new_array = np.zeros((input_array.shape[0], input_array.shape[1])) # generate empty image array
        #j = int(input_array.shape[1]/5)
        j = 5
        new_array[:,:j] =  input_array[:,:j]
        new_array[:,j:] = np.where(input_array[:,j:]>0.1*np.amax(input_array), input_array[:,j:], 0) # pad remaining array w/ zeros unless > threshold
        test_otherpeak = np.where(np.array([max_(row[i:]) for row, i in zip(new_array[:,j:], new_array[:,j:].argmin(axis=1)-(input_array.shape[1]-j))]) > 0.14*np.amax(input_array), True, False) # array of True or False for each row if it has another peak
        argmax_test_otherpeak = np.array([np.argmax(row[i:]) for row, i in zip(new_array[:,j:], new_array[:,j:].argmin(axis=1))])
        
        def no_zeros(a):
            # Create an array that is 1 where a is 0, and pad each end with an extra 0.
            iszero = np.concatenate(([0], np.equal(a, 0).view(np.int8), [0]))
            absdiff = np.abs(np.diff(iszero))
            # Runs start and end where absdiff is 1.
            ranges = np.where(absdiff == 1)[0].reshape(-1, 2)
            return ranges[:,1]-ranges[:,0]

        
        n = 0
        while n < len(test_otherpeak):
            if test_otherpeak[n] is True:
                index = j+new_array[:,j:].argmin(axis=1)[n]+int(argmax_test_otherpeak[n]/2)
                new_array[n,index:] -= new_array[n,index:] # sets them to zero
            else:
                runs = no_zeros(new_array[n])
                for i in range(len(runs)):
                    if runs[i] > 20:
                        index = j+new_array[:,j:].argmin(axis=1)[n]+np.sum(runs[:i+1])
                        new_array[n,index:] -= new_array[n,index:] # sets them to zero
            n += 1
        end = time.time()
        print("Time taken by peak_selector: ", end - start)
        return new_array
                
    def cartesian2polar(self, input_array, weighted_centre = False, 
                        inverse = False, zoom = False):
        """Converts array from Cartesian to polar coordinates, or vice-versa."""
        if inverse is False:
            if weighted_centre is True:
                x, y = self.find_centre(input_array)
            else:
                brightness_array = self.image2array(self.makesquare(self.image))
                y, x = np.unravel_index(brightness_array.argmax(), 
                                        brightness_array.shape)
            if zoom is False:
                value = np.sqrt(((input_array.shape[0]/2)**2.0)+((
                        input_array.shape[1]/2)**2.0))
            else:
                start = time.time()
                def no_zeros(a):
                    iszero = np.concatenate(([0], np.equal(a, 0).view(np.int8), [0]))
                    absdiff = np.abs(np.diff(iszero))
                    ranges = np.where(absdiff == 1)[0].reshape(-1, 2)
                    return ranges[:,1]-ranges[:,0]
                # counter_x = 0
                # j, i = 0, 0
                # while j < input_array.shape[0]:
                    # a = not np.any(input_array[:,j])
                    # if a is True:
                        # counter_x += 1
                    # j += 1
                # counter_y = 0
                # while i < input_array.shape[1]:
                    # a = not np.any(input_array[:,i])
                    # if a is True:
                        # counter_y += 1
                    # i += 1
                # counter = int(max(counter_x, counter_y)[0][0])
                # self.area = counter_x*counter_y*np.pi
                # ratio = counter/len(input_array)
                # if ratio != 0:
                    # value = int(ratio*np.sqrt(((input_array.shape[0]/2)**2.0)+((
                            # input_array.shape[1]/2)**2.0)))
                # else:
                    # value = int(min(input_array.shape[0]/2, 
                                    # input_array.shape[1]/2)[0][0]-5)
                a = no_zeros(input_array[x,:])
                if len(a) > 1: valuex = np.sort(a)[-2]
                else: valuex = a[0]
                b = no_zeros(input_array[:,y])
                if len(b) > 1: valuey = np.sort(b)[-2]
                else: valuey = b[0]
                c = no_zeros(np.diagonal(input_array))
                if len(c) > 1: valued1 = np.sort(c)[-2]
                else: valued1 = c[0]
                d = no_zeros(np.diagonal(np.flip(input_array, axis=1)))
                if len(d) > 1: valued2 = np.sort(d)[-2]
                else: valued2 = d[0]
                values = np.sort(np.array([valuex, valuey, valued1, valued2]))
                values = input_array.shape[0]/2-values
                value = np.sqrt(values[0]**2+values[1]**2)+10
                end = time.time()
                print("Time taken to zoom: ", end-start)
                self.pixelsize = self.pixelsize*input_array.shape[0]/(2*value)
            polar_image = linearPolar(input_array, (x, y), value, 
                                      WARP_FILL_OUTLIERS)
            polar_image = polar_image.astype(np.uint8)
            return polar_image
            
        else:
            cartesian_image = linearPolar(input_array, (
                    int(input_array.shape[0]/2), int(input_array.shape[1]/2)), 
                len(input_array), WARP_INVERSE_MAP)
            cartesian_image = cartesian_image.astype(np.uint8)
            return cartesian_image
            
